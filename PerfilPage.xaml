<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Catalogo_Cursos_Tarea4.PerfilPage"
    Title="Perfil"
    BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Label
                Text="Apariencia"
                FontSize="18"
                FontAttributes="Bold" />

            <Picker
                x:Name="TemaPicker"
                Title="Selecciona el tema"
                SelectedIndexChanged="OnTemaChanged">
                <Picker.Items>
                    <x:String>Automático</x:String>
                    <x:String>Claro</x:String>
                    <x:String>Oscuro</x:String>
                </Picker.Items>
            </Picker>

            <Label
                Text="Mi perfil"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource SuperficieClara}, Dark={StaticResource SuperficieOscura}}"
                Stroke="{StaticResource BordeClaro}"
                StrokeThickness="1"
                Padding="20"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Estudiante"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Información del perfil"
                        FontSize="14"
                        HorizontalOptions="Center" />

                    <Label Text="Nombre:" FontAttributes="Bold" />
                    <Entry
                        x:Name="NombrePerfilEntry"
                        Placeholder="Escribe tu nombre" />

                    <Label Text="Carrera:" FontAttributes="Bold" />
                    <Entry
                        Text="Ingeniería en Sistemas Computacionales"
                        IsReadOnly="True" />

                    <Label Text="Intereses:" FontAttributes="Bold" />
                    <Label
                        Text="Programación, tecnología y desarrollo de aplicaciones."
                        FontSize="14" />

                    <Button
                        Text="Guardar perfil"
                        Style="{StaticResource BotonPrimario}"
                        Clicked="OnGuardarPerfilClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
